{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 12,
    "sourceType": "module"
  },
  "rules": {
    "no-undef": "error",
    "no-unused-vars": "warn",
    "strict": ["error", "global"]
  },
  "globals": {
    "window": "readonly",
    "document": "readonly",
    "console": "readonly",
    "Prism": "readonly",
    "alert": "readonly",
    "requestAnimationFrame": "readonly"
  }
}
